# AI Employee — environment variables
# Copy to .env and fill in only the providers you use.
# .env is gitignored. Never commit real keys.

# --- Model provider keys ---
# Set whichever your agent.yaml references via `api_key_env`.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Local providers (Ollama, LM Studio, llama.cpp) usually accept any string.
LOCAL_API_KEY=not-needed

# --- Transport ---
# Discord webhook URL if transport.kind = discord
DISCORD_WEBHOOK_URL=

# Generic webhook URL if transport.kind = webhook
GENERIC_WEBHOOK_URL=

# --- Optional: override agent.yaml at runtime ---
# AIE_HOME=/path/to/ai-employee     # override workspace root
# AIE_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
