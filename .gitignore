# Secrets
.env
.env.local
.env.*.local

# Per-agent runtime state (never commit)
agents/*/state.json
agents/*/memory.db
agents/*/memory.db-*
agents/*/STOP
agents/*/FREEZE
agents/*/drafts/
agents/*/budget.json
agents/*/.session/

# Allow the example skeleton
!agents/example/SOUL.md
!agents/example/MEMORY.md
!agents/example/agent.yaml

